# Mail provider: "graph" or "imap"
MAIL_PROVIDER=graph

# Microsoft Graph API (used when MAIL_PROVIDER=graph)
GRAPH_TENANT_ID=your-tenant-id
GRAPH_CLIENT_ID=your-client-id
GRAPH_CLIENT_SECRET=your-client-secret
GRAPH_MAILBOX=user@example.com
# Fetch messages received in the last N hours (read and unread); dedup uses local state.
GRAPH_MESSAGE_LOOKBACK_HOURS=72
# After successful processing, PATCH message isRead=true (needs Mail.ReadWrite on the app).
GRAPH_MARK_READ=true

# Gmail IMAP (used when MAIL_PROVIDER=imap)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your.address@gmail.com
IMAP_APP_PASSWORD=your_16_char_app_password
IMAP_MAILBOX=INBOX

# General
POLL_INTERVAL_SECONDS=30
MAX_EMAILS_PER_CYCLE=25
OUTPUT_ROOT=./output
LINK_SUBSTRING=download.example.com
LINK_DOMAIN_ALLOWLIST=download.example.com
CMR_KEYWORD=CMR
PLAYWRIGHT_HEADFUL=false
DRY_RUN=true
PRINT_ENABLED=false
PRINTNODE_API_KEY=your-printnode-api-key
PRINTNODE_PRINTER_ID=75362967
PRINT_NOT_BEFORE_UTC=
# Compare content fingerprints in logs without changing duplicate decisions.
DUPLICATE_CONTENT_HASH_SHADOW=false
RETENTION_DELETE_AFTER_DAYS=7
LOG_LEVEL=INFO
